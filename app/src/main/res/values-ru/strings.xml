    <string name="rule_wizard_step_filters_title">Добавьте фильтры</string>
    <string name="rule_wizard_step_filters_body">Правило затронет только уведомления, соответствующие этим фильтрам.</string>
    <string name="rule_wizard_example_now">сейчас</string>
    <string name="rule_wizard_example_title">Ваш заказ доставлен</string>
