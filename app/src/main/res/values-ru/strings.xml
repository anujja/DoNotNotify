    <!-- Rule creation wizard -->
    <string name="rule_wizard_step_app_title">Выберите приложение</string>
    <string name="rule_wizard_step_app_body">К уведомлениям какого приложения применять это правило? В этом списке — приложения, отправлявшие уведомления на этом устройстве, а также распознанные установленные приложения.</string>
    <string name="rule_wizard_app_not_listed">Приложения нет в списке?</string>
    <string name="rule_wizard_enter_package">Введите имя его пакета</string>
    <string name="rule_wizard_package_label">Имя пакета</string>
    <string name="rule_wizard_package_hint">напр. com.example.app</string>
    <string name="rule_wizard_package_help">Приложения появляются в списке после того, как отправят уведомление. Имя пакета выглядит как com.example.app — его можно найти в URL страницы приложения в Play Маркете.</string>
    <string name="rule_wizard_package_warning">Это не похоже на имя пакета, но вы всё равно можете его использовать.</string>
    <string name="rule_wizard_no_known_apps_title">Пока нет приложений для отображения</string>
    <string name="rule_wizard_no_known_apps_desc">Приложения появятся здесь, когда отправят уведомление. Вы также можете ввести имя пакета ниже.</string>
