<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Apply the same policy to cloud backups and device-to-device transfers. -->
    <cloud-backup>
        <include domain="file" path="rules.json" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="rules.json" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
